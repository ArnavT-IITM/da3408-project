    {
      "id": 12,
      "title": "Seasonal input drift",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aircast-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "description": "Absolute difference between the recent input mean and the training reference mean for the same city and calendar month, divided by max(reference standard deviation, 1). Threshold 1.0 prompts investigation; drift does not prove model failure or lockdown causation.",
      "targets": [
        {
          "refId": "A",
          "expr": "aircast_drift_score",
          "legendFormat": "{{city}}",
          "datasource": {
