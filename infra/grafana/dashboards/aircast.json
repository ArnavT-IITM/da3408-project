{
  "uid": "aircast",
  "title": "AirCast Operations",
  "description": "Actual local AIOps metrics. During accelerated historical replay the x-axis is execution time; forecast dates remain in the application history. Dashboard and datasource are provisioned from Git.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "2s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "aircast",
    "aiops"
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Service health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aircast-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "description": "HTTP health probes performed by the API. Model serving remains unavailable until a model is deployed. A missing series is not proof of health.",
      "targets": [
        {
          "refId": "A",
          "expr": "aircast_service_up",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aircast-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Awaiting observations",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Serving model version",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aircast-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "description": "Version confirmed by the model serving process, not merely a registry alias.",
      "targets": [
        {
          "refId": "A",
          "expr": "aircast_model_version",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "aircast-prometheus"
          },
          "instant": true,
          "range": false
